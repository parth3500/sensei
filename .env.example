# ==============================================================================
# Sensei - Environment Configuration Template
# Copy this file to .env and configure your secrets locally.
# DO NOT commit real secrets or API keys to version control.
# ==============================================================================

# Application Security
APP_PASSPHRASE=your-secure-passphrase-here
TZ=Asia/Kolkata

# AI Service (Optional - for AI Tutor & Question Generation)
OPENROUTER_API_KEY=

# Google Drive Storage Integration (Optional - for Cloud Note Sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=

# Server Ports (Optional overrides)
PORT=5000
FRONTEND_PORT=3000
